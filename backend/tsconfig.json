{
  "compilerOptions": {
    /* Language and Environment */
    "target": "es6",

    /* Modules */
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist/",

    /* Type Checking */
    "strict": true,
    "skipLibCheck": true
  }
}
